@author: shambhuraj
"""
# Creating an empty dictionary
inventory = {}

# Adding initial items
inventory["Apples"] = 50
inventory["Bananas"] = 30
inventory["Oranges"] = 20

print("Inventory after adding items:")
print(inventory)

# Adding new stock
inventory["Mangoes"] = 40
print("\nInventory after adding new stock:")
print(inventory)

# Updating stock of an existing item
inventory["Apples"] += 20
print("\nInventory after updating stock:")
print(inventory)
